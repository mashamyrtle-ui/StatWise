# StatWise Backend Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for AI-powered MCQ generation)
# Get your key at: https://aistudio.google.com/app/apikey
LLM_API_KEY=your-gemini-api-key-here

# AI Model (gemini-1.5-flash is fastest and free-tier friendly)
LLM_MODEL=gemini-1.5-flash

# Other settings
DATABASE_URL=sqlite+aiosqlite:///./statsetu.db
SECRET_KEY=statwise-hackathon-secret-key
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
FRONTEND_URL=http://localhost:3000
